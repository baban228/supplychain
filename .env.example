# Copy to .env. These values are for local development only.
SUPPLIER_DB_PASSWORD=supplychain_dev_password
ORDER_DB_USER=supplychain
ORDER_DB_PASSWORD=supplychain_dev_password
DELIVERY_DB_USER=supplychain
DELIVERY_DB_PASSWORD=supplychain_dev_password

# Wolf Auth Service PostgreSQL
AUTH_DB_USER=wolf_auth
AUTH_DB_PASSWORD=wolf_auth_dev_password
AUTH_DB_NAME=wolf_auth
AUTH_TOKEN_EXPIRE_MINUTES=30

# Development-only shared HS256 secret. Replace with a random secret
# of at least 32 UTF-8 bytes. Must be identical to SECRET_KEY in Auth Service.
AUTH_JWT_SECRET=local-dev-only-change-me-32-bytes-min

# Internal Docker Compose address of the Auth Service
AUTH_SERVICE_URL=http://auth-service:3001

# Consul Service Discovery (internal Docker network)
CONSUL_HOST=consul
CONSUL_PORT=8500

# Order Service -> Supplier Service HTTP resilience
SUPPLIER_CLIENT_TIMEOUT=2s
SUPPLIER_RETRY_MAX_ATTEMPTS=3
SUPPLIER_RETRY_WAIT=300ms
